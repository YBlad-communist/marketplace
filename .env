JWT_ISSUER=marketplace-api

# === App ===
APP_URL=https://rinokru.com
API_URL=https://rinokru.com/api
PORT=4000

# === Cookies / CORS ===
COOKIE_SECURE=true
COOKIE_DOMAIN=rinokru.com
CORS_ORIGINS=https://rinokru.com

# === S3 / MinIO (отдельный поддомен!) ===
S3_ENDPOINT=https://s3.rinokru.com
S3_REGION=auto
S3_BUCKET=marketplace
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://s3.rinokru.com/marketplace
S3_MAX_IMAGE_BYTES=5242880

# === ЮKassa (пока пусто) ===
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_PLATFORM_FEE_BASIS_POINTS=200
YOOKASSA_HOLD_TTL_DAYS=7
YOOKASSA_INSECURE_WEBHOOKS=false
RELEASING_RECOVERY_AFTER_MS=300000

# === Frontend (NEXT_PUBLIC_* — БЕЗ /api! Код сам добавляет) ===
NEXT_PUBLIC_API_URL=https://rinokru.com
NEXT_PUBLIC_APP_URL=https://rinokru.com

# === SmartCaptcha (отключена) ===
SMARTCAPTCHA_SECRET_KEY=
SMARTCAPTCHA_ENABLED=false

# === SMTP (нужны непустые значения — иначе api крашится) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=noreply@rinokru.com
SMTP_PASS=dummy
MAIL_FROM="Marketplace <no-reply@rinokru.com>"
SMTP_SECURE=false

# === SMS.RU (отключено, но должны быть непустые поля) ===
SMS_RU_API_KEY=test_key_dummy
SMS_RU_TEST=true
SMS_RU_SIGNATURE=Marketplace

# === Прочее ===
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
REVIEW_MIN_ORDER_TOTAL=100
REVIEW_PAIR_LIMIT=1
REVIEW_PAIR_WINDOW_DAYS=30
OFFLINE_EMAIL_COOLDOWN_MS=600000
ADMIN_EMAIL=netot2010@gmail.com
