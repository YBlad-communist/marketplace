# === Cookies / CORS ===
COOKIE_SECURE=false
COOKIE_DOMAIN=rinokru.com
CORS_ORIGINS=http://rinokru.com

# === S3 / MinIO ===
S3_ENDPOINT=http://s3.rinokru.com
S3_REGION=auto
S3_BUCKET=marketplace
