NODE_ENV=production

# === PostgreSQL / Redis (localhost — приложения на сервере, БД в Docker) ===
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379

# === JWT ===
JWT_ACCESS_SECRET=+wxmFqxIcO128brEnmD2u9HkDj87NCZNP2B1V3WZvao=
JWT_REFRESH_SECRET=BnseSoZjByiss7ahlsst+S2CJx1I70vZtS0W1neIX1k=
