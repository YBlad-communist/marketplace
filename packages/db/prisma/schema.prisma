generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ListingStatus {
  PENDING
  ACTIVE
  RESERVED
  SOLD
  REJECTED
  ARCHIVED
}

/// Состояние товара (объявления).
enum ItemCondition {
  NEW
  USED
}

/// Способ получения товара.
enum HandoverMethod {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING
  PAID
  RELEASING
  RELEASED
  REFUNDING
  REFUNDED
  DISPUTED
  // SHIPPED добавлен в КОНЕЦ перечисления: так же значение добавляется в БД
  // (ALTER TYPE ... ADD VALUE дописывает в конец), порядок совпадает у схемы и БД.
  SHIPPED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  RANGE
}

enum ReportTargetType {
  LISTING
  USER
  MESSAGE
}

enum ReportReason {
  SPAM
  FRAUD
  INAPPROPRIATE
  COPYRIGHT
  DUPLICATE
  PROHIBITED
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// Платёжный провайдер сделки (этап абстракции платежей).
// MOCK — только тесты/дев-окружение, в проде не используется.
enum PaymentProvider {
  YOOKASSA
  MONETA
  MOCK
}

model User {
    id                 String                     @id @default(cuid())
    email              String?                    @unique
    phone              String?                    @unique
  passwordHash       String?
  name               String
  avatarUrl          String?
  city               String?
  role               UserRole                   @default(USER)
  isVerified         Boolean                    @default(false)
  isBanned           Boolean                    @default(false)
  banReason          String?
  rating             Float                      @default(0)
  ratingCount        Int                        @default(0)
  // --- Поля онбординга продавца ---
  // Провайдер-нейтральные: payoutAccountId — Shop ID (ЮKassa) или
  // MNT_ACCOUNT_ID расширенного счёта (Монета). yookassa* — legacy на время
  // переезда (обслуживаются до полного перехода, удаление — отдельным решением).
  payoutAccountId    String?
  payoutOnboarded    Boolean                    @default(false)
  yookassaShopId     String?
  yookassaOnboarded  Boolean                    @default(false)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  loginFailCount     Int                        @default(0)
  lockUntil          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  listings           Listing[]
  sentMessages       Message[]                  @relation("sender")
  conversationParts  ConversationParticipant[]
  reviewsReceived    Review[]                   @relation("reviewee")
  reviewsAuthored    Review[]                   @relation("author")
  favorites          Favorite[]
  orders             Order[]                    @relation("buyer")
  disputesOpened     Dispute[]                  @relation("DisputeOpener")
  disputesResolved   Dispute[]                  @relation("DisputeResolver")
  reportsAuthored    Report[]                   @relation("author")
  viewedListings     ViewedListing[]
  savedSearches      SavedSearch[]
  verificationCodes  VerificationCode[]

  @@index([city])
}

model Category {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  icon       String?
  parentId   String?
  parent     Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]        @relation("CategoryTree")
  attributes CategoryAttribute[]
  listings   Listing[]
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([parentId])
}

model CategoryAttribute {
  id           String        @id @default(cuid())
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key          String
  label        String
  type         AttributeType
  unit         String?
  required     Boolean       @default(false)
  options      Json? // для SELECT: ["new","used"] и т.п.
  min          Float?
  max          Float?
  sortOrder    Int           @default(0)

  @@unique([categoryId, key])
}

model Listing {
  id          String            @id @default(cuid())
  title       String
  description String
  price       Decimal           @db.Decimal(12, 2)
  currency    String            @default("RUB")
  status      ListingStatus     @default(PENDING)
  sellerId    String
  seller      User              @relation(fields: [sellerId], references: [id])
  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id])
  city        String
  // Связь с локацией (регион → город): новые объявления создаются через cityId,
  // строковое city остаётся для обратной совместимости (fallback при чтении).
  cityId      String?
  cityRef     City?             @relation(fields: [cityId], references: [id])
  // Точный адрес (улица, дом, метро) — необязательное поле объявления.
  address     String?
  lat         Float?
  lng         Float?
  // Состояние товара и способ получения — опциональные поля (старые
  // объявления без значений просто не фильтруются по ним).
  condition   ItemCondition?
  handover    HandoverMethod?
  attributes  Json              @default("{}")
  viewsCount  Int               @default(0)
  searchTs    Unsupported("tsvector")?
  moderationNote String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  images       ListingImage[]
  favoritedBy  Favorite[]
  conversations Conversation[]
  // История заказов не ограничена одним: после возврата/выплаты объявление
  // снова продаётся, поэтому связь one-to-many. Активный заказ один — это
  // держит частичный уникальный индекс Order_listingId_active_key.
  orders       Order[]
  viewedBy     ViewedListing[]

  @@index([categoryId, status, city])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, price])
  @@index([sellerId, status])
  @@index([city, status])
  @@index([cityId])
}

model Region {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model City {
  id        String    @id @default(cuid())
  name      String
  slug      String
  regionId  String
  region    Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([regionId, slug])
  @@index([regionId])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  key       String   @unique
  url       String
  thumbUrl  String?
  width     Int?
  height    Int?
  position  Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

model Conversation {
  id           String   @id @default(cuid())
  listingId    String?
  listing      Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([listingId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime?
  // П.30: мягкое скрытие чата для инициатора; hard delete — когда скрыли оба.
  hiddenAt       DateTime?

  @@id([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("sender", fields: [senderId], references: [id])
  text           String
  // П.31: оригинальный текст сохраняется при первой правке (история).
  originalText   String?
  editedAt       DateTime?
  imageKey       String?
  imageThumbKey  String?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
  // П.20 аудита: прокси /api/files ищет сообщение по ключу фото, чтобы
  // отдать приватный файл только участникам диалога — без индексов
  // каждый GET картинки превращался бы в seq scan по растущей таблице.
  @@index([imageKey])
  @@index([imageThumbKey])
}

model Order {
  id                       String      @id @default(cuid())
  // Без @unique: после возврата/выплаты история заказов по объявлению растёт.
  // «Не более одного активного заказа» держит частичный уникальный индекс
  // Order_listingId_active_key (миграция 20261008000001). В схеме индекс
  // НЕ объявлен: Prisma не умеет видеть индексы с WHERE-предикатом, любая
  // декларация привела бы к drift (generate CREATE существующего индекса).
  listingId                String
  listing                  Listing     @relation(fields: [listingId], references: [id])
  buyerId                  String
  buyer                    User        @relation("buyer", fields: [buyerId], references: [id])
  amount                   Decimal     @db.Decimal(12, 2)
  currency                 String      @default("RUB")
  status                   OrderStatus @default(PENDING)
  // --- Провайдер платежа (этап абстракции) ---
  // providerPaymentId — идентификатор платежа у активного провайдера сделки
  // (yookassaPaymentId — legacy, дублируется на время переезда).
  provider                 PaymentProvider @default(YOOKASSA)
  providerPaymentId        String?
  providerPayoutId         String?
  yookassaPaymentId        String?
  platformFee              Decimal?    @db.Decimal(12, 2)
  releasedAt               DateTime?
  // Срок холда: когда удержание денег заканчивается (для предупреждений
  // и перевода SHIPPED-заказа в DISPUTED вместо авто-возврата).
  holdExpiresAt            DateTime?
  shippedAt                DateTime?
  shipComment              String?
  trackingNumber           String?
  // Одноразовые флаги предупреждений покупателя (за 2 дня и за 12 часов).
  holdWarned2dAt           DateTime?
  holdWarned12hAt          DateTime?
  dispute                  Dispute?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  idempotencyKey           String?     @unique
  reviews                  Review[]

  @@index([buyerId, createdAt])
  @@index([status])
  @@index([status, holdExpiresAt])
  @@index([providerPaymentId])
}

model Dispute {
  id                 String        @id @default(cuid())
  orderId            String        @unique
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // null — спор открыл системный воркер (истёкший холд у SHIPPED-заказа).
  openedById         String?
  openedBy           User?         @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: SetNull)
  reason             String
  comment            String?
  // Ключи изображений в S3 (до 5 шт.), URL резолвит API.
  photos             String[]
  status             DisputeStatus @default(OPEN)
  // 'SELLER' — выплата продавцу, 'BUYER' — возврат покупателю.
  resolution         String?
  // Обязателен при вынесении решения (проверяет API); null, пока спор открыт.
  resolutionComment  String?
  resolvedById       String?
  resolvedBy         User?         @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  resolvedAt         DateTime?

  @@index([status, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation("author", fields: [authorId], references: [id])
  revieweeId String
  reviewee   User     @relation("reviewee", fields: [revieweeId], references: [id])
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating     Int
  text       String?
  createdAt  DateTime @default(now())

  @@unique([authorId, revieweeId, orderId])
  @@index([revieweeId])
}

model Favorite {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@index([listingId])
}

model ViewedListing {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @updatedAt

  @@id([userId, listingId])
  @@index([userId, viewedAt])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // EMAIL_VERIFY, PHONE_VERIFY, PASSWORD_RESET
  channel   String // EMAIL, PHONE
  target    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([purpose, userId])
  @@index([target, purpose, consumedAt])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     Json // фильтры поиска
  notifyNew Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Report {
  id         String            @id @default(cuid())
  authorId   String
  author     User              @relation("author", fields: [authorId], references: [id])
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  comment    String?
  status     ReportStatus      @default(PENDING)
  resolvedBy String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status, createdAt])
}

model RefreshTokenFamily {
  id        String    @id @default(cuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedBy String?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}
