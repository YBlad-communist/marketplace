# ============================================================
#  Marketplace — environment template
#  Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

NODE_ENV=development

# --- App ---
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- PostgreSQL ---
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_48_chars_min_random_base64
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_48_chars_min_random_base64
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=marketplace-api

# --- Cookies ---
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# --- CORS (comma separated whitelist) ---
CORS_ORIGINS=http://localhost:3000

# --- S3 / MinIO (R2 / AWS S3 compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=marketplace
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/marketplace
S3_MAX_IMAGE_BYTES=5242880

# --- Stripe (payments / Connect) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_CONNECT_ONBOARDING_URL=http://localhost:3000/seller/connect
STRIPE_PLATFORM_FEE_BASIS_POINTS=200
# Возраст PAID-заказа в днях, после которого холд считаем истёкшим (джоба worker'а).
STRIPE_HOLD_TTL_DAYS=7
# Email администратора для уведомлений о chargeback-спорах (опционально).
ADMIN_EMAIL=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URL=http://localhost:4000/api/auth/oauth/google/callback

# --- Cloudflare Turnstile (CAPTCHA) ---
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false

# --- SMTP (emails via worker) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Marketplace <no-reply@localhost>
SMTP_SECURE=false

# --- SMS.RU (verification codes via worker) ---
SMS_RU_API_KEY=
SMS_RU_TEST=true
SMS_RU_SIGNATURE=

# --- Frontend (NEXT_PUBLIC_*) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true

# --- Logging ---
LOG_LEVEL=info
