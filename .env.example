# ============================================================
#  Marketplace — environment template
#  Скопируйте в .env:  cp .env.example .env
#  Затем заполните ТОЛЬКО блоки «ВСТАВЬТЕ СЮДА».
#  Остальное уже настроено под docker-compose.yml.
#  Никогда не коммитьте .env в git!
# ============================================================

NODE_ENV=development

# --- App ---
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- PostgreSQL (совпадает с docker-compose.yml) ---
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

# --- Redis (совпадает с docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# ============================================================
#  >>> ВСТАВЬТЕ СЮДА — JWT (обязательно)
#  Сгенерируйте:  openssl rand -base64 48
#  или:           node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#  Два РАЗНЫХ значения — не копируйте одно в другое!
# ============================================================
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_with_openssl_rand_base64_48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=marketplace-api

# --- Cookies / CORS (можно не трогать) ---
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

# --- S3 / MinIO (совпадает с docker-compose.yml, можно не трогать) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=marketplace
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/marketplace
S3_MAX_IMAGE_BYTES=5242880

# ============================================================
#  >>> ВСТАВЬТЕ СЮДА — Stripe (обязательно для платежей)
#  Test mode: https://dashboard.stripe.com/test/apikeys
#  Скопируйте:
#    STRIPE_SECRET_KEY      = sk_test_...  (Secret key)
#    STRIPE_PUBLISHABLE_KEY = pk_test_...  (Publishable key)
#  Webhook (локально): установите Stripe CLI, затем
#    stripe login
#    stripe listen --forward-to localhost:4000/api/webhooks/stripe
#  CLI выдаст whsec_... — вставьте его в STRIPE_WEBHOOK_SECRET.
#  Для продакшена создайте webhook в Dashboard и скопируйте signing secret.
#  Без этих ключей платежные эндпоинты отвечают 500 "Stripe не настроен",
#  остальной сайт (каталог, чат, профиль) работает.
# ============================================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_CONNECT_ONBOARDING_URL=http://localhost:3000/seller/connect
STRIPE_PLATFORM_FEE_BASIS_POINTS=200
# Сколько дней PAID-заказ висит в холде до авто-возврата (worker).
STRIPE_HOLD_TTL_DAYS=7
# Email админа для уведомлений о chargeback-спорах (опционально).
ADMIN_EMAIL=

# ============================================================
#  >>> ВСТАВЬТЕ СЮДА — Google OAuth (опционально)
#  https://console.cloud.google.com/apis/credentials
#  Создайте OAuth 2.0 Client (Web application), добавьте
#  Authorized redirect URI: http://localhost:4000/api/auth/oauth/google/callback
#  Без этих ключей работает вход по телефону/паролю.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:4000/api/auth/oauth/google/callback

# --- Cloudflare Turnstile CAPTCHA (опционально, по умолчанию выкл) ---
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false

# --- Frontend (NEXT_PUBLIC_*) ---
# Для pnpm dev (локально) — дублируют значения выше.
# Для docker compose — подставляются автоматически из STRIPE_PUBLISHABLE_KEY.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- SMTP (опционально, по умолчанию MailHog) ---
# Локально: docker compose включает MailHog (1025/8025), письма видно на http://localhost:8025
# Продакшен: укажите реальный SMTP (Yandex, Mail.ru, SendGrid и т.д.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Marketplace <no-reply@localhost>
SMTP_SECURE=false

# --- SMS.RU (опционально) ---
# https://sms.ru — для реальных SMS-кодов. Пусто = заглушка (код в логах worker'а).
SMS_RU_API_KEY=
SMS_RU_TEST=true
SMS_RU_SIGNATURE=

# --- Прочее (можно не трогать) ---
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# --- Rate limit и прокси (audit) ---
# Сколько прокси-хопов между клиентом и API. Express берёт правый адрес из
# X-Forwarded-For. Должно быть ЧИСЛОМ (не true!), иначе подмена заголовка
# обходит rate limit. Nginx: 1, Cloudflare: 2 (web + edge) и т.п.
TRUST_PROXY_HOPS=1

# --- Отзывы (audit) ---
# Порог суммы завершённого заказа для отзыва (анти-накрутка копеечными сделками).
REVIEW_MIN_ORDER_TOTAL=100
# Не больше отзывов между одной парой пользователей за период (дни).
REVIEW_PAIR_LIMIT=1
REVIEW_PAIR_WINDOW_DAYS=30

# --- Офлайн-уведомления (audit) ---
# Окно (мс) между дайджест-письмами о новых сообщениях в один диалог.
OFFLINE_EMAIL_COOLDOWN_MS=600000

# --- Recovery выплат (audit) ---
# Возраст RELEASING-заказа (мс), после которого worker сверяется со Stripe
# и доводит (или откатывает) выплату после обрыва процесса.
RELEASING_RECOVERY_AFTER_MS=300000
