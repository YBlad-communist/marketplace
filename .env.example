# ============================================================
#  Marketplace — шаблон окружения
#  Скопируйте в .env:  cp .env.example .env
#  Заполните ОБЯЗАТЕЛЬНЫЕ блоки (БД/Redis, JWT) и по мере
#  необходимости — ЮKassa, SmartCaptcha, SMTP, SMS.RU (S3 уже
#  настроен под docker-compose.yml).
#  Никогда не коммитьте .env в git!
# ============================================================

NODE_ENV=development

# --- App ---
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000                     # порт API (по умолчанию 4000, менять не нужно)
# Адрес(bind) слушания API — аудит п.33: по умолчанию 127.0.0.1, наружу
# трафик отдаёт только локальный nginx. В Docker HOST=0.0.0.0 задаёт
# Dockerfile (публикация порта в docker-compose привязана к 127.0.0.1 хоста).
HOST=127.0.0.1

# ============================================================
#  ОБЯЗАТЕЛЬНО — PostgreSQL и Redis (совпадает с docker-compose.yml)
# ============================================================
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public
# Пароль Redis — обязателен для docker-compose (redis стартует с --requirepass).
# Локальный Redis из start.py работает без пароля: тогда оставьте REDIS_URL
# без ":пароль@" (compose сам подставит redis://:<REDIS_PASSWORD>@redis:6379).
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ============================================================
#  ОБЯЗАТЕЛЬНО — JWT (два РАЗНЫХ значения, минимум 32 символа)
#  Сгенерируйте:  openssl rand -base64 48
#  или:           node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#  Не копируйте одно значение в другое!
# ============================================================
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_with_openssl_rand_base64_48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=marketplace-api

# --- Cookies / CORS (можно не трогать) ---
# Аудит п.33: в production COOKIE_SECURE обязан быть true — иначе API
# падает при старте (guard в apps/api/src/config.ts).
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

# --- S3 / MinIO (совпадает с docker-compose.yml, можно не трогать) ---
# Аудит п.35: в production S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY обязательны
# и НЕ могут быть minioadmin — guard падает при старте. Значения minioadmin
# ниже — только локальная разработка.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=marketplace
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/marketplace
S3_MAX_IMAGE_BYTES=5242880
# Аудит п.35: креды MinIO для docker-compose — ОБЯЗАТЕЛЬНО, без дефолтов
# (docker-compose.yml ссылается через ${MINIO_ROOT_USER:?}).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ============================================================
#  >>> ВСТАВЬТЕ СЮДА — ЮKassa (обязательно для платежей и выплат)
#  Личный кабинет ЮKassa (https://yookassa.ru) → «Настройки» → «API».
#  YOOKASSA_SHOP_ID   — идентификатор вашего магазина;
#  YOOKASSA_SECRET_KEY — секретный ключ API (для разработки — ключ
#  из тестовой среды: настройках test-ключей в ЛК ЮKassa).
#  Магазин должен быть создан и пройти модерацию.
#  Продавцы на площадке подключают выплаты отдельно, указывая Shop ID
#  СВОЕГО магазина на странице /seller/connect (см. README, «Полный цикл»).
#  Без ключей платёжные эндпоинты отвечают 500 «ЮKassa не настроен»,
#  остальной сайт (каталог, чат, профиль) работает.
# ============================================================
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Комиссия платформы в базисных пунктах: 200 = 2% от суммы заказа.
YOOKASSA_PLATFORM_FEE_BASIS_POINTS=200
# Возраст PAID-заказа в днях, после которого worker отменяет холд и возвращает оплату.
YOOKASSA_HOLD_TTL_DAYS=7
# ТОЛЬКО для локальной разработки через туннель: отключает проверку IP уведомлений ЮKassa.
YOOKASSA_INSECURE_WEBHOOKS=false

# ============================================================
#  Платёжный провайдер: yookassa | moneta | mock
#  mock — только для тестов (не списывает реальные деньги).
#  moneta — Монета (docs.moneta.ru), безопасная сделка; ключи ниже.
# ============================================================
PAYMENT_PROVIDER=yookassa

# --- Монета (docs.moneta.ru) — при PAYMENT_PROVIDER=moneta ---
# MNT_ID расширенного счёта площадки (транзитный приём платежей).
MONETA_ACCOUNT_ID=
# Код проверки целостности данных («код проверки» в ЛК счёта) — для MNT_SIGNATURE.
MONETA_ACCOUNT_CODE=
# Транзитный счёт площадки (payer при переводе продавцу в безопасной сделке).
MONETA_TRANSIT_ACCOUNT=
# MerchantAPI: https://service.moneta.ru/services
MONETA_BASE_URL=https://service.moneta.ru/services
# Логин/пароль ЛК Монеты для MerchantAPI (UsernameToken).
MONETA_API_USERNAME=
MONETA_API_PASSWORD=
# Платёжный пароль счёта (для PaymentRequest в безопасной сделке).
MONETA_PAYMENT_PASSWORD=
# 1 — тестовый режим Assistant (MNT_TEST_MODE), без реального списания.
MONETA_TEST_MODE=false
# Платёжная форма Assistant: demo.moneta.ru — тестовая площадка.
MONETA_ASSISTANT_URL=https://moneta.ru/assistant.htm

# Recovery выплат (audit): возраст RELEASING-заказа в мс, после которого worker
# сверяется с ЮKassa и доводит (или откатывает) выплату после обрыва процесса.
RELEASING_RECOVERY_AFTER_MS=300000

# --- Я.Капча (SmartCaptcha, опционально, по умолчанию выключена) ---
# Секретный ключ сервера: Яндекс Облако → SmartCaptcha → ключи.
# Виджет на фронте пока не встроен — токен передаётся в запросах
# как captchaToken (см. apps/api/src/middleware/captcha.ts).
SMARTCAPTCHA_SECRET_KEY=
SMARTCAPTCHA_ENABLED=false

# --- Frontend (NEXT_PUBLIC_*) ---
# Для pnpm dev (локально) — дублируют значения выше.
# Для docker compose — заданы в docker-compose.yml (environment).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origin S3 для прямых presigned-загрузок и картинок (попадает в CSP img/connect-src,
# аудит п.34). Прод: https://s3.rinokru.com (см. apps/web/.env.production).
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/marketplace
# Платёжный виджет ЮKassa (checkout-widget.js) НЕ требует публичного ключа:
# фронт получает confirmation_token от бэкенда при создании заказа.

# --- SMTP (опционально, по умолчанию MailHog) ---
# Локально: docker compose включает MailHog (1025/8025), письма видно на http://localhost:8025
# Продакшен: укажите реальный SMTP (Yandex, Mail.ru, SendGrid и т.д.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Marketplace <no-reply@localhost>
SMTP_SECURE=false

# --- SMS.RU (опционально) ---
# https://sms.ru — для реальных SMS-кодов. Пусто = заглушка (код в логах worker'а).
# Аудит п.35: SMS_RU_TEST=false по умолчанию — тестовый режим SMS.RU
# включайте только осознанно (коды не отправляются реальным абонентам).
SMS_RU_API_KEY=
SMS_RU_TEST=false
SMS_RU_SIGNATURE=

# --- Прочее (можно не трогать) ---
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
# Аудит п.16: дополнительные стоп-слова модерации через запятую (добавляются
# к базовому списку из packages/shared/src/constants.ts).
MODERATION_BLOCKED_KEYWORDS=

# --- Rate limit и прокси (audit) ---
# Сколько прокси-хопов между клиентом и API. Express берёт правый адрес из
# X-Forwarded-For. Должно быть ЧИСЛОМ (не true!), иначе подмена заголовка
# обходит rate limit. Nginx: 1, Cloudflare: 2 (web + edge) и т.п.
TRUST_PROXY_HOPS=1

# --- Отзывы (audit) ---
# Порог суммы завершённого заказа для отзыва (анти-накрутка копеечными сделками).
REVIEW_MIN_ORDER_TOTAL=100
# Не больше отзывов между одной парой пользователей за период (дни).
REVIEW_PAIR_LIMIT=1
REVIEW_PAIR_WINDOW_DAYS=30

# --- Офлайн-уведомления (audit) ---
# Окно (мс) между дайджест-письмами о новых сообщениях в один диалог.
OFFLINE_EMAIL_COOLDOWN_MS=600000

# --- Админ-уведомления (audit) ---
# Email администратора для уведомлений о спорах/возвратах (опционально).
ADMIN_EMAIL=